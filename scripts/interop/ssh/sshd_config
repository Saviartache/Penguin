# Сервер SSH для проверки о чужую реализацию.
#
# Пароль вместо ключа: профиль в форме клиента задаётся паролем, ключ туда не
# вставить (поле однострочное), и проверять надо тот путь, которым пойдёт
# человек.
PasswordAuthentication yes
PermitRootLogin no
PubkeyAuthentication no

# То, ради чего всё и затевалось: канал `direct-tcpip` до цели. Без этой
# строки сервер поднимется, опознает клиента и откажет в канале — отказ
# выглядел бы ошибкой протокола, а не настройкой сервера.
AllowTcpForwarding yes
PermitOpen any
GatewayPorts no

# Оболочка здесь никому не нужна: клиент открывает только каналы.
AllowAgentForwarding no
X11Forwarding no
PrintMotd no
