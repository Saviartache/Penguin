# Сборка
/target
# Сборка под Linux в контейнере: своя папка, чтобы не спорить с хозяйской за
# один и тот же `target` (`scripts/interop`, проверка службы в Docker).
/target-linux
# Собранная поставка: пересобирается `./scripts/package.sh`.
/dist
**/*.rs.bk
Cargo.lock.bak

# Настройки и данные клиента.
#
# Настоящий `config.toml` содержит адрес сервера и пароль к нему. Он никогда не
# лежит в репозитории — клиент заводит его сам в каталоге пользователя, — но
# запись здесь стоит на случай, если его положат рядом «на пробу».
config.toml
*.local.toml
/.env
/local/
*.log

# Бинарные ресурсы, подтягиваемые сборкой
/assets/geoip/*.mmdb
/assets/wintun/*.dll

# Заметки и разбор: пишутся для себя, наружу не идут.
/docs/
/notes/
/scratch/

# Мусор оболочек и редакторов
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Журналы, которые роняет в каталог крейта прогон тестов демона.
penguin.log.*
.claude/worktrees/

# Проверка о чужие реализации: сертификат заводится на месте, отчёт пишется
# при каждом прогоне. Ни то, ни другое в репозитории не нужно.
/scripts/interop/tls/
/scripts/interop/report.txt
